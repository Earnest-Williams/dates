{
  "name": "dates",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "NODE_OPTIONS='--max-old-space-size=8192' node --test",
    "test:all": "NODE_OPTIONS='--max-old-space-size=32768' node --test",
    "test:ci": "bash scripts/run-tests.sh",
    "audit:actions": "node scripts/audit-actions.mjs",
    "audit:content": "node scripts/audit-content.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "audit": "node scripts/run-audit.mjs",
    "qa:content": "node scripts/content-qa-checklist.mjs",
    "precommit": "npm run lint && npm run validate:content && npm run audit:actions && npm run qa:content",
    "prepare": "husky install"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "vite": "^8.0.12"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "git add"
    ],
    "src/data/*.js": [
      "node scripts/validate-content.mjs",
      "node scripts/content-qa-checklist.mjs",
      "git add"
    ]
  }
}
